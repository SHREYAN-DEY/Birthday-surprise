# Copy to .env (never commit .env).
# VITE_* values are PUBLIC: they end up in the browser bundle. Never put secrets here.

# false = local-only mode (localStorage + IndexedDB), no backend needed
# true  = use the Express/MongoDB backend (login-protected /setup, server-side saving)
VITE_USE_BACKEND=false

# Local-only mode on a deployed site: /setup is disabled unless you set this to true.
VITE_ALLOW_SETUP_IN_PROD=false
